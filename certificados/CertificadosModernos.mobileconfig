	<key>PayloadDescription</key>
	<string>Instala las raices de certificacion modernas (Let's Encrypt, DigiCert, Google, Amazon y Baltimore) que iOS 9.3.5 no incluye. Sin ellas, las conexiones HTTPS fallan aunque la red sea correcta.</string>
	<key>PayloadDisplayName</key>
	<string>Certificados modernos (Tik9)</string>
	<key>PayloadIdentifier</key>
	<string>com.lofturb.tik9.certificados</string>
	<key>PayloadOrganization</key>
	<string>Tik9</string>
