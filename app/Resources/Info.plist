	<!-- ATS.  iOS solo negocia HTTP/2 en conexiones sujetas a ATS, y la ruta de
	     busqueda de TikTok exige HTTP/2: con el permiso global el telefono
	     hablaba HTTP/1.1 y TikTok contestaba 200 con el cuerpo vacio (cabecera
	     tt_orcas_res: 1), que es lo que parecia "no hay resultados".  El aviso
	     medido del 18/10/2026 es que una excepcion por dominio NO basta
	     mientras el permiso global siga puesto (el sistema sigue hablando
	     HTTP/1.1 incluso con www.tiktok.com exigido a TLS 1.2), asi que ahora
	     ATS se exige de verdad en toda la app.

	     Los CDNs de TikTok se dejan relajados por si alguno flojea, aunque los
	     medidos (v16m.tiktokcdn.com, v16-webapp.tiktok.com, ...) cumplen ATS de
	     sobra: TLS 1.2 con ECDHE-ECDSA.  Lo que se pierde en iOS 9 es el relay
	     por HTTP plano; NSAllowsLocalNetworking (iOS 10 en adelante) lo deja
	     seguir funcionando en dispositivos nuevos. -->
	<key>NSAppTransportSecurity</key>
	<dict>
		<key>NSAllowsArbitraryLoads</key>
		<false/>
		<key>NSAllowsArbitraryLoadsForMedia</key>
		<true/>
		<key>NSAllowsLocalNetworking</key>
		<true/>
		<key>NSExceptionDomains</key>
		<dict>
			<!-- El dominio de la API y del feed: ATS de verdad, sin relajacion.
			     Es el que tiene que negociar HTTP/2. -->
			<key>www.tiktok.com</key>
			<dict>
				<key>NSExceptionAllowsInsecureHTTPLoads</key>
				<false/>
				<key>NSExceptionRequiresForwardSecrecy</key>
				<true/>
				<key>NSExceptionMinimumTLSVersion</key>
				<string>TLSv1.2</string>
			</dict>
			<!-- Los CDNs, relajados: son miniaturas, musica y video. -->
			<key>tiktokcdn.com</key>
			<dict>
				<key>NSIncludesSubdomains</key>
				<true/>
				<key>NSExceptionAllowsInsecureHTTPLoads</key>
				<true/>
				<key>NSExceptionRequiresForwardSecrecy</key>
				<false/>
				<key>NSExceptionMinimumTLSVersion</key>
				<string>TLSv1.0</string>
			</dict>
			<key>tiktokcdn-us.com</key>
			<dict>
				<key>NSIncludesSubdomains</key>
				<true/>
				<key>NSExceptionAllowsInsecureHTTPLoads</key>
				<true/>
				<key>NSExceptionRequiresForwardSecrecy</key>
				<false/>
				<key>NSExceptionMinimumTLSVersion</key>
				<string>TLSv1.0</string>
			</dict>
			<key>tiktokv.com</key>
			<dict>
				<key>NSIncludesSubdomains</key>
				<true/>
				<key>NSExceptionAllowsInsecureHTTPLoads</key>
				<true/>
				<key>NSExceptionRequiresForwardSecrecy</key>
				<false/>
				<key>NSExceptionMinimumTLSVersion</key>
				<string>TLSv1.0</string>
			</dict>
			<key>ttwstatic.com</key>
			<dict>
				<key>NSIncludesSubdomains</key>
				<true/>
				<key>NSExceptionAllowsInsecureHTTPLoads</key>
				<true/>
				<key>NSExceptionRequiresForwardSecrecy</key>
				<false/>
				<key>NSExceptionMinimumTLSVersion</key>
				<string>TLSv1.0</string>
			</dict>
			<key>ibyteimg.com</key>
			<dict>
				<key>NSIncludesSubdomains</key>
				<true/>
				<key>NSExceptionAllowsInsecureHTTPLoads</key>
				<true/>
				<key>NSExceptionRequiresForwardSecrecy</key>
				<false/>
				<key>NSExceptionMinimumTLSVersion</key>
				<string>TLSv1.0</string>
			</dict>
			<key>byteoversea.com</key>
			<dict>
				<key>NSIncludesSubdomains</key>
				<true/>
				<key>NSExceptionAllowsInsecureHTTPLoads</key>
				<true/>
				<key>NSExceptionRequiresForwardSecrecy</key>
				<false/>
				<key>NSExceptionMinimumTLSVersion</key>
				<string>TLSv1.0</string>
			</dict>
			<key>muscdn.com</key>
			<dict>
				<key>NSIncludesSubdomains</key>
